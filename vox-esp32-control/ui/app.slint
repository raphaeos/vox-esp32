import { AboutSlint, VerticalBox } from "std-widgets.slint";

import {
    State,
    AppState,
    PowerState,
    PowerVAEntry,
    PowerVAType,
    PowerVAStatus,
    PowerTypeSummary,
    PowerTypeStatus,
    PowerMPPTStatus,
    PowerMPPTSummary,
    PowerMPPTBatteryType,
    Page,
    Theme,
    BaseStyle,
} from "common.slint";
import { Sidebar } from "components/sidebar.slint";
import {
    HomePage,
} from "./pages/pages.slint";

import "assets/NotoSans-Regular.ttf";
import "assets/NotoSans-Medium.ttf";

export {
    PowerMPPTSummary,
    PowerMPPTStatus,
    PowerMPPTBatteryType,
    PowerTypeSummary,
    PowerTypeStatus,
    PowerVAStatus,
    PowerVAType,
    PowerVAEntry,
    PowerState,
    AppState,
    State,
    Theme,
}
export component AppWindow inherits Window {
    title: @tr("Vox Control");

    width: 480px;
    height: 320px;
    full-screen: true;
    default-font-family: "Noto Sans";
    default-font-size: 30px;

    Image {
        source: BaseStyle.background-image;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }

    Rectangle {
        if !State.screensaver-active:
            HorizontalLayout {
                side-bar := Sidebar { }

                main-view := Rectangle {
                    if State.active-page == Page.home: home-page := HomePage { }
                }
            }
    }
}
